            <div class="modal-form-group">
                <label for="clienteNombre">Nombre:</label>
                <input type="text" id="clienteNombre" placeholder="Tu primer nombre">
            </div>
            
            <div class="modal-form-group">
                <label for="clienteApellido">Apellido:</label>
                <input type="text" id="clienteApellido" placeholder="Tus apellidos">
            </div>
            
            <div class="modal-form-group">
                <label for="clienteCorreo">Correo Electrónico:</label>
                <input type="email" id="clienteCorreo" placeholder="ejemplo@correo.com">
