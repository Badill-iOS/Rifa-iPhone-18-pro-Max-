            <button class="btn-trash" onclick="vaciarCarrito()" title="Vaciar todos los números">🗑️</button>
        </div>
        <button class="btn-pay" onclick="abrirModalDatos()">Ir a pagar por WhatsApp</button>
    </div>

    <div class="modal-overlay" id="modalDatos">
        <div class="modal-box">
