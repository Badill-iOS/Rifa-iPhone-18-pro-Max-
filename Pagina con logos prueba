<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rifa iPhone 18 Pro Max - Badill-iOS</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f8fafc;
            color: #1e293b;
            line-height: 1.6;
            padding-bottom: 140px; /* Espacio para el carrito flotante */
        }

        /* Encabezado Premium */
        header {
            background: linear-gradient(135deg, #0f172a, #1e293b);
            color: white;
            text-align: center;
            padding: 3rem 1rem;
            border-bottom: 4px solid #3b82f6;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }

        header h1 { 
            font-size: 2.2rem; 
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            background: linear-gradient(to right, #ffffff, #94a3b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .subtitle-brand {
            font-size: 1.2rem;
            font-weight: 600;
            color: #3b82f6;
            margin-bottom: 0.5rem;
        }

        .company-tag {
            font-size: 0.85rem;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .price-badge {
            display: inline-block;
            background: #e11d48;
            color: white;
            padding: 0.4rem 1.2rem;
            border-radius: 50px;
            font-size: 1.1rem;
            font-weight: 800;
            margin-top: 1rem;
            box-shadow: 0 4px 10px rgba(225, 29, 72, 0.3);
        }

        .container {
            max-width: 1000px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        /* Estilos para las imágenes integradas */
        .imagen-web-banner {
            width: 100%;
            max-width: 450px;
            height: auto;
            border-radius: 12px;
            border: 2px solid #3b82f6;
            box-shadow: 0 6px 20px rgba(59, 130, 246, 0.2);
            display: block;
            margin: 1.5rem auto;
            object-fit: cover;
        }

        .imagen-web-secundaria {
            width: 100%;
            max-width: 350px;
            height: auto;
            border-radius: 12px;
            border: 2px solid #e2e8f0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            display: block;
            margin: 1.5rem auto;
            object-fit: cover;
        }

        /* Cuadro de Instrucciones del Sorteo */
        .info-sorteo {
            background: white;
            border-left: 5px solid #3b82f6;
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            margin-bottom: 2rem;
        }

        .info-sorteo h2 {
            font-size: 1.2rem;
            color: #0f172a;
            margin-bottom: 0.8rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .info-sorteo p {
            font-size: 0.95rem;
            color: #475569;
            margin-bottom: 0.8rem;
        }

        .ejemplo-caja {
            background: #f1f5f9;
            padding: 1rem;
            border-radius: 8px;
            font-size: 0.9rem;
            color: #334155;
            border: 1px dashed #cbd5e1;
        }

        /* Buscador */
        .search-box {
            background: white;
            padding: 1.5rem;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            margin-bottom: 2rem;
            text-align: center;
            border: 1px solid #e2e8f0;
        }

        .search-input-wrapper {
            display: flex;
            justify-content: center;
            gap: 12px;
            max-width: 450px;
            margin: 0 auto;
        }

        .search-box input {
            padding: 0.8rem;
            font-size: 1rem;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            width: 70%;
            outline: none;
            transition: border-color 0.2s;
        }

        .search-box input:focus {
            border-color: #3b82f6;
        }

        .btn-search {
            padding: 0.8rem 1.5rem;
            background-color: #3b82f6;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.2s;
        }

        .btn-search:hover { background-color: #2563eb; }

        .search-result {
            margin-top: 1.2rem;
            font-weight: bold;
        }

        /* Pestañas (Tabs) */
        .tabs-container {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 12px;
            margin-bottom: 1.5rem;
        }

        .tabs-container::-webkit-scrollbar { display: none; }

        .tab-btn {
            background-color: #e2e8f0;
            color: #475569;
            padding: 0.8rem 1.4rem;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 700;
            white-space: nowrap;
            font-size: 0.95rem;
            transition: all 0.2s;
        }

        .tab-btn.active {
            background-color: #0f172a;
            color: white;
            box-shadow: 0 4px 10px rgba(15, 23, 42, 0.25);
        }

        /* Cuadrícula de Números */
        .grid-numeros {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(95px, 1fr));
            gap: 12px;
            background: white;
            padding: 1.5rem;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            max-height: 50vh;
            overflow-y: auto;
            border: 1px solid #e2e8f0;
        }

        /* Botones de Números Libres */
        .num-block {
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f1f5f9;
            color: #334155;
            padding: 0.9rem 0.5rem;
            font-weight: 700;
            border-radius: 8px;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            border: 1px solid #e2e8f0;
            user-select: none;
        }

        .num-block:hover {
            background-color: #e2e8f0;
            border-color: #cbd5e1;
        }

        /* Seleccionado */
        .num-block.selected {
            background-color: #3b82f6;
            color: white;
            border-color: #2563eb;
            box-shadow: 0 0 10px rgba(59, 130, 246, 0.4);
        }

        /* Números Comprados / Eliminados */
        .num-block.comprado {
            background-color: #1e293b;
            color: #ef4444;
            text-decoration: line-through;
            border-color: #0f172a;
            cursor: not-allowed;
            font-size: 0.9rem;
            gap: 4px;
            opacity: 0.85;
            pointer-events: none;
        }

        /* CARRITO FLOTANTE */
        .cart-floating {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: white;
            box-shadow: 0 -10px 30px rgba(0,0,0,0.1);
            padding: 1.2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            z-index: 998; 
            transform: translateY(100%);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            border-top: 1px solid #e2e8f0;
        }

        .cart-floating.visible {
            transform: translateY(0);
        }

        .cart-info {
            font-size: 1.1rem;
            font-weight: 700;
            color: #0f172a;
        }

        .cart-total {
            color: #25d366;
            font-size: 1.2rem;
            font-weight: 800;
        }

        /* Fila de la Lista con Basurero */
        .cart-list-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
            max-width: 90%;
            width: 100%;
            justify-content: center;
        }

        .cart-list {
            font-size: 0.95rem;
            color: #64748b;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            background: #f8fafc;
            padding: 0.4rem 1.2rem;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            flex-grow: 1;
            max-width: 400px;
            text-align: center;
        }

        /* Botón Basurero Estilizado */
        .btn-trash {
            background-color: #fee2e2;
            color: #ef4444;
            border: 1px solid #fca5a5;
            border-radius: 50%;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1.1rem;
            transition: all 0.2s;
            flex-shrink: 0;
        }

        .btn-trash:hover {
            background-color: #ef4444;
            color: white;
            border-color: #dc2626;
            transform: scale(1.05);
        }

        .btn-pay {
            background-color: #25d366;
            color: white;
            border: none;
            padding: 0.9rem 2.5rem;
            border-radius: 10px;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            text-align: center;
            box-shadow: 0 4px 12px rgba(37, 211, 102, 0.25);
            transition: all 0.2s;
        }

        .btn-pay:hover {
            background-color: #1ebea5;
            transform: translateY(-1px);
        }

        /* INTERFAZ DEL MODAL COMPACTO CON SCROLL Y BOTÓN DE CIERRE */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(5px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s ease;
            padding: 10px; 
        }

        .modal-overlay.open {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-box {
            background: white;
            padding: 1.2rem;
            border-radius: 14px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);
            position: relative;
            transform: scale(0.92);
            transition: transform 0.25s ease;
            max-height: 90vh; 
            overflow-y: auto; 
        }

        .modal-overlay.open .modal-box {
            transform: scale(1);
        }

        /* Botón de cerrar X roja */
        .modal-close-x {
            position: absolute;
            top: 10px;
            right: 14px;
            background: none;
            border: none;
            color: #ef4444;
            font-size: 1.5rem;
            font-weight: bold;
            cursor: pointer;
            line-height: 1;
            padding: 5px;
            transition: transform 0.2s;
        }
        .modal-close-x:hover {
            transform: scale(1.15);
        }

        .modal-box h3 {
            font-size: 1.25rem;
            color: #0f172a;
            margin-bottom: 0.3rem;
            font-weight: 800;
            padding-right: 25px; 
        }

        .modal-box p {
            font-size: 0.85rem;
            color: #64748b;
            margin-bottom: 1rem;
        }

        .modal-form-group {
            margin-bottom: 0.8rem;
            text-align: left;
        }

        .modal-form-group label {
            display: block;
            font-size: 0.75rem;
            font-weight: 700;
            color: #475569;
            margin-bottom: 0.2rem;
            text-transform: uppercase;
        }

        .modal-form-group input {
            width: 100%;
            padding: 0.6rem;
            font-size: 0.95rem;
            border: 2px solid #e2e8f0;
            border-radius: 6px;
            outline: none;
            transition: border-color 0.2s;
        }

        .modal-form-group input:focus {
            border-color: #3b82f6;
        }

        .modal-buttons {
            display: flex;
            gap: 10px;
            margin-top: 1.2rem;
        }

        .btn-modal-cancel {
            flex: 1;
            padding: 0.7rem;
            background: #f1f5f9;
            color: #64748b;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            font-size: 0.9rem;
        }

        .btn-modal-submit {
            flex: 2;
            padding: 0.7rem;
            background: #25d366;
            color: white;
            border: none;
            border-radius: 6px;
            font-weight: 700;
            cursor: pointer;
            font-size: 0.9rem;
            box-shadow: 0 4px 10px rgba(37, 211, 102, 0.15);
        }

        .btn-modal-submit:hover { background: #1ebea5; }

        footer {
            text-align: center;
            padding: 2rem 1rem;
            background-color: #0f172a;
            color: #94a3b8;
            font-size: 0.85rem;
            margin-top: 3rem;
            border-top: 2px solid #1e293b;
        }
    </style>
</head>
