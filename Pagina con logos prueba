        <p style="font-size: 0.75rem; margin-top: 5px; color: #64748b;">Desarrollado por Herald Badilla Mora • Soporte WhatsApp: +506 5014-9399</p>
    </footer>

    <script>
        const TU_TELEFONO = "50650149399";
        const PRECIO_NUMERO = 400; 
        
        // 🎫 AQUÍ PONER LOS NÚMEROS VENDIDOS:
        const NUMEROS_COMPRADOS = [
            5, 12, 77, 500, 1005, 2026, 2323, 7777
        ]; 

        let carrito = [];
        let serieInicioActual = 0;
        let serieFinActual = 999;

        window.onload = function() {
            cambiarSerie(0, 999, document.querySelector('.tab-btn'));
        };

        function formatearNumero(num) {
            return num.toString().padStart(4, '0');
        }

        function cambiarSerie(inicio, fin, elementoTab) {
            serieInicioActual = inicio;
            serieFinActual = fin;
            
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            elementoTab.classList.add('active');

            const grid = document.getElementById('gridNumeros');
            grid.innerHTML = ""; 

            const fragmento = document.createDocumentFragment();

            for (let i = inicio; i <= fin; i++) {
                const bloque = document.createElement('div');
                const numeroFormateado = formatearNumero(i);
                
                if (NUMEROS_COMPRADOS.includes(i)) {
                    bloque.className = "num-block comprado";
                    bloque.innerHTML = `🔒 ${numeroFormateado}`;
                } else {
                    bloque.className = "num-block";
                    bloque.textContent = numeroFormateado;
                    if (carrito.includes(numeroFormateado)) {
                        bloque.classList.add('selected');
                    }
                }
                
                if (!NUMEROS_COMPRADOS.includes(i)) {
                    bloque.onclick = function() {
                        seleccionarNumero(numeroFormateado, bloque);
                    };
                }
                
                fragmento.appendChild(bloque);
            }
            grid.appendChild(fragmento);
        }

        function refrescarVistaGrid() {
            const tabActivo = document.querySelector('.tab-btn.active');
            if (tabActivo) {
                cambiarSerie(serieInicioActual, serieFinActual, tabActivo);
            }
        }

        function seleccionarNumero(numeroTexto, elementoHtml) {
            const index = carrito.indexOf(numeroTexto);
            
            if (index > -1) {
                carrito.splice(index, 1);
                elementoHtml.classList.remove('selected');
            } else {
                carrito.push(numeroTexto);
                elementoHtml.classList.add('selected');
            }
            
            carrito.sort((a, b) => parseInt(a) - parseInt(b));
            actualizarInterfazCarrito();
        }

        function vaciarCarrito() {
            if (carrito.length === 0) return;
            
            if (confirm("¿Estás seguro de que deseas quitar todos los números seleccionados?")) {
                carrito = [];
                actualizarInterfazCarrito();
                refrescarVistaGrid();
                document.getElementById('resultadoBusqueda').innerHTML = "";
                document.getElementById('numeroBuscado').value = "";
            }
        }

        function actualizarInterfazCarrito() {
            const cartBar = document.getElementById('carritoFlotante');
            const cartCount = document.getElementById('cartCount');
            const cartList = document.getElementById('cartList');
            const cartTotal = document.getElementById('cartTotal');

            if (carrito.length > 0) {
                cartBar.classList.add('visible');
                cartCount.textContent = carrito.length;
                cartList.textContent = carrito.join(', ');
                
                const montoTotal = carrito.length * PRECIO_NUMERO;
                cartTotal.textContent = "₡" + montoTotal.toLocaleString('es-CR');
            } else {
                cartBar.classList.remove('visible');
            }
        }

        function abrirModalDatos() {
            if (carrito.length === 0) return;
            document.getElementById('modalDatos').classList.add('open');
        }

        function cerrarModalDatos() {
            document.getElementById('modalDatos').classList.remove('open');
        }

        function validarYEnviar() {
            const nombre = document.getElementById('clienteNombre').value.trim();
            const apellido = document.getElementById('clienteApellido').value.trim();
            const correo = document.getElementById('clienteCorreo').value.trim();
            const telefono = document.getElementById('clienteTelefono').value.trim();

            if(!nombre || !apellido || !correo || !telefono) {
                alert("Por favor completa todos los campos antes de enviar.");
                return;
            }

            const montoTotal = carrito.length * PRECIO_NUMERO;

            const textoMensaje = 
`🔥 *¡RESERVA IPHONE 18 PRO MAX!* 🔥
━━━━━━━━━━━━━━━━━━━━━━━━━━

👤 *CLIENTE:*
• ${nombre} ${apellido}
• Tel: ${telefono}
• Correo: ${correo}

🎟️ *MIS NÚMEROS:*
