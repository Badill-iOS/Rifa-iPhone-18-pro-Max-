        function buscarNumero() {
            const val = document.getElementById('numeroBuscado').value;
            const res = document.getElementById('resultadoBusqueda');
            res.innerHTML = "";

            if(!val) return;
            const num = parseInt(val);

            if(num >= 0 && num <= 9999) {
                const numFormateado = formatearNumero(num);
                
                if (NUMEROS_COMPRADOS.includes(num)) {
                    res.innerHTML = `<span style="color: #dc3545;">🔒 El número ${numFormateado} ya fue vendido.</span>`;
                } 
                else if (carrito.includes(numFormateado)) {
                    res.innerHTML = `<span style="color: #f59e0b;">⚠️ El número ${numFormateado} ya está agregado en tu carrito de compras abajo.</span>`;
                } 
                else {
                    const textoBusqueda = `¡Hola! Quiero consultar y apartar el número de rifa específico: ${numFormateado}`;
                    res.innerHTML = `
                        <span style="color: #28a745;">¡Número ${numFormateado} disponible! (₡400)</span><br>
                        <p style="font-size:0.9rem; color:#666; margin: 5px 0;">Puedes buscarlo en sus pestañas para añadirlo al carrito o pedirlo directo aquí:</p>
                        <a href="https://wa.me/${TU_TELEFONO}?text=${encodeURIComponent(textoBusqueda)}" 
